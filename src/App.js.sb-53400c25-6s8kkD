function AnmeldungPage({ onSuccess }) {
  const [form, setForm] = useState({vorname:"",nachname:"",klasse:"",schulart:"",lehrer:"",handy:""});
  const [selected, setSelected] = useState([]);
  const [errors, setErrors] = useState({});
  const [submitting, setSubmitting] = useState(false);

  const toggleCompany = (c) => {
    if (selected.includes(c)) setSelected(selected.filter(x=>x!==c));
    else if (selected.length < 5) setSelected([...selected, c]);
  };

  const validate = () => {
    const e = {};
    if (!form.vorname.trim()) e.vorname = "Pflichtfeld";
    if (!form.nachname.trim()) e.nachname = "Pflichtfeld";
    if (!form.klasse) e.klasse = "Bitte auswählen";
    if (!form.schulart) e.schulart = "Bitte auswählen";
    if (!form.handy.trim()) e.handy = "Handynummer angeben";
    if (selected.length === 0) e.companies = "Bitte mindestens 1 Unternehmen wählen";
    return e;
  };

  const submit = async () => {
    const e = validate();
    setErrors(e);
    if (Object.keys(e).length > 0) return;
    setSubmitting(true);
    const { error } = await supabase.from("anmeldungen").insert([{
      vorname: form.vorname, nachname: form.nachname,
      lehrer: form.lehrer, handy: form.handy,
      klasse: form.klasse, schulart: form.schulart,
      companies: selected.join(", "), status: "neu"
    }]);
    setSubmitting(false);
    if (!error) onSuccess({...form, companies: selected, id: Date.now(), date: new Date().toLocaleDateString("de-DE"), status:"neu"});
    else alert("Fehler beim Speichern. Bitte nochmal versuchen.");
  };

  const F = ({name, label, type="text", placeholder, required=false}) => (
    <div className="field">
      <label>{label}{required && <span style={{color:"#c0392b"}}> *</span>}</label>
      <input type={type} placeholder={placeholder} value={form[name]}
        onChange={e=>{setForm({...form,[name]:e.target.value});setErrors({...errors,[name]:null});}}
        style={errors[name]?{borderColor:"#c0392b"}:{}}/>
      {errors[name] && <div className="err">{errors[name]}</div>}
    </div>
  );

  return (
    <div className="page" style={{background:CREAM}}>
      <div className="form-page">
        <div>
          <h1 className="form-h1">Workshop-<em>Anmeldung</em></h1>
          <p className="form-lead">Melde dich für Unternehmens-Workshops an. Du kannst bis zu <strong>5 Unternehmen</strong> wählen.</p>
        </div>
        <div className="form-card">
          <div className="form-section-title"><span className="num">1</span> Persönliche Angaben</div>
          <div className="field-row">
            <F name="vorname" label="Vorname" placeholder="Max" required />
            <F name="nachname" label="Nachname" placeholder="Mustermann" required />
          </div>
          <div className="field-row">
            <div className="field">
              <label>Schulart <span style={{color:"#c0392b"}}>*</span></label>
              <select value={form.schulart} onChange={e=>{setForm({...form,schulart:e.target.value});setErrors({...errors,schulart:null});}} style={errors.schulart?{borderColor:"#c0392b"}:{}}>
                <option value="">Bitte wählen…</option>
                {SCHULARTEN.map(s=><option key={s}>{s}</option>)}
              </select>
              {errors.schulart && <div className="err">{errors.schulart}</div>}
            </div>
            <div className="field">
              <label>Klasse <span style={{color:"#c0392b"}}>*</span></label>
              <select value={form.klasse} onChange={e=>{setForm({...form,klasse:e.target.value});setErrors({...errors,klasse:null});}} style={errors.klasse?{borderColor:"#c0392b"}:{}}>
                <option value="">Bitte wählen…</option>
                {KLASSEN.map(k=><option key={k}>{k}</option>)}
              </select>
              {errors.klasse && <div className="err">{errors.klasse}</div>}
            </div>
          </div>
          <div className="field-row">
            <F name="lehrer" label="Lehrkraft (optional)" placeholder="Frau Müller" />
            <F name="handy" label="Handynummer" placeholder="+49 176 …" required />
          </div>
        </div>
        <div className="form-card">
          <div className="form-section-title"><span className="num">2</span> Wunsch-Unternehmen wählen</div>
          <p className="company-count">Ausgewählt: <span>{selected.length}</span> / 5{errors.companies && <span style={{color:"#c0392b",marginLeft:"1rem"}}>{errors.companies}</span>}</p>
          {selected.length===5 && <div className="max-warn">✓ Du hast 5 Unternehmen gewählt – das ist das Maximum.</div>}
          <div className="company-grid">
            {COMPANIES.map(c=>(
              <button key={c} className={`company-btn${selected.includes(c)?" selected":""}`}
                onClick={()=>toggleCompany(c)}
                style={selected.length===5&&!selected.includes(c)?{opacity:.4,cursor:"not-allowed"}:{}}>
                <span className="check">{selected.includes(c)?"✓":""}</span>{c}
              </button>
            ))}
          </div>
        </div>
        <button className="submit-btn" onClick={submit} disabled={submitting}>
          {submitting?"Wird gespeichert…":"Anmeldung absenden →"}
        </button>
        <p style={{fontSize:".75rem",color:MUTED,textAlign:"center",marginTop:".8rem"}}>Deine Daten werden nur für die Workshop-Koordination verwendet.</p>
      </div>
    </div>
  );
}

